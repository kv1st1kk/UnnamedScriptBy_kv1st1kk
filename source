local player = game.Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.IgnoreGuiInset = true
gui.Parent = player:FindFirstChild("PlayerGui")

local image = Instance.new("ImageLabel")
image.Size = UDim2.new(1, 0, 1, 0)
image.Position = UDim2.new(0, 0, 0, 0)
image.BackgroundColor3 = Color3.new(0, 0, 0)
image.BackgroundTransparency = 0
image.Image = "rbxassetid://668614178"
image.ScaleType = Enum.ScaleType.Stretch
image.ZIndex = 10
image.Visible = false
image.ImageColor3 = Color3.new(1, 1, 1)
image.Parent = gui

local sound = Instance.new("Sound")
sound.SoundId = "rbxassetid://9043354317"
sound.Volume = 10
sound.Parent = game.SoundService

local TweenService = game:GetService("TweenService")

local function flickerEffect(duration)
	local startTime = tick()
	while tick() - startTime < duration do
		local randomBrightness = math.random(50, 255) / 255
		local tweenInfo = TweenInfo.new(math.random(0.05, 0.2), Enum.EasingStyle.Linear, Enum.EasingDirection.InOut)
		local tween = TweenService:Create(image, tweenInfo, { ImageColor3 = Color3.new(randomBrightness, randomBrightness, randomBrightness) })
		tween:Play()
		wait(math.random(0.05, 0.2))
	end
	image.ImageColor3 = Color3.new(1, 1, 1)
end

wait(3)

image.Visible = true
sound:Play()

flickerEffect(6)

wait(0.3)
image.Visible = false
sound:Stop()
